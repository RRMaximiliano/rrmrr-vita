\RequirePackage{fontspec}
\RequirePackage{url}
%%%------------------------------------------------------------------------
%%% Git version tracking
%%%------------------------------------------------------------------------

%% vc.tex is written by vc.sh, which latexmk runs before every build (see
%% .latexmkrc). It records the last commit that changed the CV source, so the
%% footer points to the exact source of the PDF. Reading .git/ by hand broke
%% on packed refs and in worktrees, and the date was the compile date.
\providecommand{\cvcommit}{}
\providecommand{\cvcommitfull}{}
\providecommand{\cvdate}{\today}
\InputIfFileExists{vc.tex}{}{}

% Other hanging require packages
\RequirePackage{enumitem}

\RequirePackage[svgnames]{xcolor}
\definecolor{darkblue}{rgb}{0.0,0.0,0.3}
\RequirePackage{soul}
